# kabuステーション（Azure Windows VM 上の localhost）
# 検証: http://localhost:18081  / 本番: http://localhost:18080
# 注意: 18080/18081 を NSG・ルータでインターネット公開しないこと
KABU_BASE_URL=http://localhost:18081
KABU_API_PASSWORD=
# 発注時のみ（カブステの取引パスワード）。LIVE 時必須
KABU_TRADE_PASSWORD=
# 特定口座=4（一般的）。違う場合は変更
KABU_ACCOUNT_TYPE=4
# 現物買の預り区分: 信用口座なしは 02（保護）。AA は信用代用→未開設だと 100204
KABU_FUND_TYPE=02
# AA を使う場合のみ 1（通常は不要）
# KABU_ALLOW_CREDIT_FUND=0
# 現物買の受渡: 2=お預り金 / 3=auマネーコネクト（有効時のみ）
KABU_DELIV_TYPE=2
# 現物発注の市場: 1(東証)は2026-02以降不可→100378。27=東証+ / 9=SOR
KABU_EXCHANGE=27

# AQUA（SWA）
AQUA_BRIDGE_URL=https://www.aquacore.net
# SWA の STOCK_KABU_BRIDGE_SECRET と同じ値
AQUA_BRIDGE_SECRET=
AQUA_USER_ID=

# 自動発注ゲート（デフォルトは dry-run。本番発注は明示的に 1）
KABU_ALLOW_LIVE_ORDERS=0
# カンマ区切り。空ならウォッチ売り候補の全JP保有が対象
KABU_SYMBOL_WHITELIST=
KABU_MAX_QTY_PER_ORDER=200
