{
  "routes": [
    {
      "route": "/stocks/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/disney/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/costs/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/*",
      "allowedRoles": ["anonymous", "authenticated"]
    }
  ],
  "platform": {
    "apiRuntime": "node:20"
  }
}
