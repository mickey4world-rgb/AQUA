{
  "routes": [
    {
      "route": "/api/users/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/stocks/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/disney/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/costs/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/council/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/docs/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/space/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/settings",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/stocks/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/disney/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/costs/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/council/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/docs/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/space/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/*",
      "allowedRoles": ["anonymous", "authenticated"]
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/login"
    }
  },
  "platform": {
    "apiRuntime": "node:20"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  }
}
