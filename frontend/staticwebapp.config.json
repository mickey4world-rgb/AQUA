{
  "routes": [
    {
      "route": "/api/users/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/stocks/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/public/*",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/tdr-preview",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/api/disney/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/costs/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/council/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/docs/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/works/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/space/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/settings",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/stocks/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/disney/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/costs/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/council/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/docs/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/works-preview",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/neo-preview",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/works/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/space/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/soluna/cron/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/soluna/shortcut/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/soluna/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/*",
      "allowedRoles": ["anonymous", "authenticated"]
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/login"
    }
  },
  "platform": {
    "apiRuntime": "node:20"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "X-Permitted-Cross-Domain-Policies": "none",
    "X-DNS-Prefetch-Control": "off",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(self), geolocation=()",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "Cross-Origin-Opener-Policy": "same-origin-allow-popups",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; connect-src 'self' https:; frame-src blob: https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; font-src 'self' data: https://cdn.jsdelivr.net"
  }
}
