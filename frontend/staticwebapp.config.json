{
  "routes": [
    {
      "route": "/api/users/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/stocks/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/disney/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/costs/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/settings",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/stocks/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/disney/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/costs/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/*",
      "allowedRoles": ["anonymous", "authenticated"]
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/login"
    }
  },
  "platform": {
    "apiRuntime": "node:20"
  }
}
